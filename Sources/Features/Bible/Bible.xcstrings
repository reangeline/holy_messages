    "There is no Bible in this language in the app yet. It will come in an update, in a published Catholic translation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no Bible in this language in the app yet. It will come in an update, in a published Catholic translation."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há Bíblia neste idioma no app. Ela virá numa atualização, numa tradução católica publicada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay una Biblia en este idioma en la app. Llegará en una actualización, en una traducción católica publicada."
          }
        }
      }
    },
