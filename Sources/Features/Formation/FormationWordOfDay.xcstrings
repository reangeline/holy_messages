        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La próxima parte espera hasta mañana. Lo que leíste hoy se aprende rezando, no leyendo más."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima parte espera até amanhã. O que você leu hoje se aprende rezando, não lendo mais."
