    "Rever o dia, reconhecer onde houve consolação e onde houve desolação, e responder. É a prática inaciana, em quatro toques.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the day, recognize where there was consolation and where there was desolation, and respond. It's the Ignatian practice, in four taps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repasar el día, reconocer dónde hubo consolación y dónde hubo desolación, y responder. Es la práctica ignaciana, en cuatro toques."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rever o dia, reconhecer onde houve consolação e onde houve desolação, e responder. É a prática inaciana, em quatro toques."
          }
        }
      }
    },
