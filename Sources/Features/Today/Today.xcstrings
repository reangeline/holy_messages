    "Precisa de mais do que isto? Padre, diocese, ou uma crise": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Need more than this? Priest, diocese, or a crisis"
          }
        },
        "es": {
