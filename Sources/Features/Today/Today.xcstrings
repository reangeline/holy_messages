    "Este app oferece formação e oração. Não é terapia nem atendimento clínico, e não finge ser.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app offers formation and prayer. It is not therapy or clinical care, and it doesn't pretend to be."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app ofrece formación y oración. No es terapia ni atención clínica, y no finge serlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app oferece formação e oração. Não é terapia nem atendimento clínico, e não finge ser."
          }
        }
      }
    },
