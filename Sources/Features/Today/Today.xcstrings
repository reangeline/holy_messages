    "Este app oferece formação e oração. Não é terapia nem atendimento clínico, e não finge ser.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app offers formation and prayer. It is not therapy or clinical care, and it doesn't pretend to be."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app ofrece formación y oración. No es terapia ni atención clínica, y no finge serlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app oferece formação e oração. Não é terapia nem atendimento clínico, e não finge ser."
          }
        }
      }
    },
    "Este registro entra no seu calendário. Ninguém além de você o vê — ele não sai deste aparelho.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This entry goes into your calendar. No one but you sees it — it never leaves this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registro entra en tu calendario. Nadie más que tú lo ve — nunca sale de este dispositivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registro entra no seu calendário. Ninguém além de você o vê — ele não sai deste aparelho."
          }
        }
      }
    },
