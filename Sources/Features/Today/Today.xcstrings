    "Faz algumas semanas que os dias têm vindo pesados": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The days have been heavy for a few weeks now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace algunas semanas que los días han estado pesados"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz algumas semanas que os dias têm vindo pesados"
          }
        }
      }
    },
    "Feche o aplicativo agora. O que começou aqui continua em silêncio — a conversa com Deus não precisa de mais tela, só do seu íntimo.": {
      "extractionState": "manual",
      "localizations": {
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche o aplicativo agora. O que começou aqui continua em silêncio — a conversa com Deus não precisa de mais tela, só do seu íntimo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the app now. What began here continues in silence — the conversation with God needs no more screen, only your own heart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la aplicación ahora. Lo que empezó aquí continúa en silencio — la conversación con Dios no necesita más pantalla, solo tu interior."
          }
        }
      }
    },
    "Fica em pausa": {
      "localizations": {
        "en": {
          "stringUnit": {
