    "A record, not a scoreboard. No streak to lose.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A record, not a scoreboard. No streak to lose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un registro, no un marcador. Sin racha que perder."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro, não placar. Sem sequência para perder."
          }
        }
      }
    },
