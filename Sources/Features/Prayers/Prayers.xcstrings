        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si nunca lo rezó, empiece aquí. Casi todo el mundo se traba en la mecánica, no en la fe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se nunca rezou, comece aqui. Quase todo mundo trava na mecânica, não na fé."
