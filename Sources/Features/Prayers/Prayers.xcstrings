    "Put the phone in your pocket. A tap advances, a vibration confirms, and nothing lights up until you finish.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the phone in your pocket. A tap advances, a vibration confirms, and nothing lights up until you finish."
