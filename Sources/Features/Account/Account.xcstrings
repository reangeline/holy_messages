{
  "sourceLanguage": "pt",
  "strings": {
    "Create your Missale account": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create your Missale account"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea tu cuenta en Missale"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie sua conta no Missale"
          }
        }
      }
    },
    "It keeps your subscription and opens the way to the personal guidance — you write what you feel and receive a word from Scripture and the saints.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It keeps your subscription and opens the way to the personal guidance — you write what you feel and receive a word from Scripture and the saints."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tu suscripción y abre el camino a la orientación personalizada: escribes lo que sientes y recibes una palabra de las Escrituras y de los santos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela guarda a sua assinatura e abre caminho para a orientação personalizada: você escreve o que sente e recebe uma palavra das Escrituras e dos santos."
          }
        }
      }
    },
    "What you write and log stays on your iPhone, as before.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you write and log stays on your iPhone, as before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que escribes y registras sigue en tu iPhone, como siempre."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você escreve e registra continua no seu iPhone, como sempre."
          }
        }
      }
    },
    "Apple lets you hide your email. There is no password to create.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple lets you hide your email. There is no password to create."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple te permite ocultar tu correo. No hay contraseña que crear."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple deixa você esconder o seu e-mail. Não há senha para criar."
          }
        }
      }
    },
    "You can delete the account in Settings whenever you want.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can delete the account in Settings whenever you want."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes eliminar la cuenta en Ajustes cuando quieras."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode apagar a conta nos Ajustes quando quiser."
          }
        }
      }
    },
    "We couldn't sign you in. Check your connection and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't sign you in. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos iniciar sesión. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos entrar. Verifique a sua conexão e tente de novo."
          }
        }
      }
    },
    "Account": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta"
          }
        }
      }
    },
    "Signed in with Apple": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed in with Apple"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado con Apple"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado com a Apple"
          }
        }
      }
    },
    "Sign out": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar sesión"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair da conta"
          }
        }
      }
    },
    "Delete account": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar cuenta"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar conta"
          }
        }
      }
    },
    "Delete your account?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your account?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar tu cuenta?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar a sua conta?"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "Your account is erased from our server. What you wrote stays on this iPhone — erase it in Your data. A subscription is not cancelled by this: cancel it in the App Store.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is erased from our server. What you wrote stays on this iPhone — erase it in Your data. A subscription is not cancelled by this: cancel it in the App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta se borra de nuestro servidor. Lo que escribiste sigue en este iPhone: para borrarlo, usa Tus datos. La suscripción no se cancela desde aquí: cancélala en la App Store."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua conta é apagada do nosso servidor. O que você escreveu continua neste iPhone: para apagar, use Seus dados. A assinatura não é cancelada por aqui: cancele na App Store."
          }
        }
      }
    },
    "We couldn't delete the account. Check your connection and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't delete the account. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos eliminar la cuenta. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos apagar a conta. Verifique a sua conexão e tente de novo."
          }
        }
      }
    },
    "Got it": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendido"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendi"
          }
        }
      }
    }
  },
  "version": "1.0"
}