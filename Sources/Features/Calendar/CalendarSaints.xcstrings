    "By liturgical time, the way the Church counts the year. Not by month, and without comparing them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By liturgical time, the way the Church counts the year. Not by month, and without comparing them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por tiempo litúrgico, como la Iglesia cuenta el año. No por mes, y sin comparar unos con otros."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por tempo litúrgico, como a Igreja conta o ano. Não por mês, e sem comparação entre eles."
          }
        }
      }
    },
