    "By liturgical time, the way the Church counts the year. Not by month, and without comparing them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By liturgical time, the way the Church counts the year. Not by month, and without comparing them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por tiempo litúrgico, como la Iglesia cuenta el año. No por mes, y sin comparar unos con otros."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por tempo litúrgico, como a Igreja conta o ano. Não por mês, e sem comparação entre eles."
          }
        }
      }
    },
    "No progress curve and no percentage: desolation isn't failure, and dryness isn't a performance dip.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No progress curve and no percentage: desolation isn't failure, and dryness isn't a performance dip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin curva de progreso y sin porcentaje: la desolación no es fracaso, y la aridez no es una caída de desempeño."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem curva de progresso e sem percentual: desolação não é fracasso, e aridez não é queda de desempenho."
          }
        }
      }
    },
