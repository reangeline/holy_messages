    "No heat map and no good-day/bad-day colors: the color is the liturgy's, the mark is yours.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No heat map and no good-day/bad-day colors: the color is the liturgy's, the mark is yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin mapa de calor y sin colores de día bueno o malo: el color es de la liturgia, la marca es tuya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem mapa de calor e sem cores de bom e mau dia: a cor é da liturgia, a marca é sua."
          }
        }
      }
    },
