    "No heat map and no good-day/bad-day colors: the color is the liturgy's, the mark is yours.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No heat map and no good-day/bad-day colors: the color is the liturgy's, the mark is yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin mapa de calor y sin colores de día bueno o malo: el color es de la liturgia, la marca es tuya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem mapa de calor e sem cores de bom e mau dia: a cor é da liturgia, a marca é sua."
          }
        }
      }
    },
    "No progress curve and no percentage: desolation isn't failure, and dryness isn't a performance dip.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No progress curve and no percentage: desolation isn't failure, and dryness isn't a performance dip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin curva de progreso y sin porcentaje: la desolación no es fracaso, y la aridez no es una caída de desempeño."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem curva de progresso e sem percentual: desolação não é fracasso, e aridez não é queda de desempenho."
          }
        }
      }
    },
