        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo no app está disponível sem ela. Se você assinou com outro Apple ID, restaure abaixo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo en la app está disponible sin ella. Si te suscribiste con otro Apple ID, restaura abajo."
          }
        }
      }
    },
