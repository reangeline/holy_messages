    "The answers are the same for everyone who picks the same state. Spiritual direction is someone who knows your story and answers you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answers are the same for everyone who picks the same state. Spiritual direction is someone who knows your story and answers you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas son las mismas para todos los que eligen el mismo estado. La dirección espiritual es alguien que conoce tu historia y te responde a ti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas são as mesmas para todos que escolhem o mesmo estado. Direção espiritual é alguém que conhece a sua história e responde a você."
