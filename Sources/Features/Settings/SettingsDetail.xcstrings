    "The subscription renews automatically until canceled. Cancellation happens in your App Store account settings, at least 24 hours before the period ends.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subscription renews automatically until canceled. Cancellation happens in your App Store account settings, at least 24 hours before the period ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción se renueva automáticamente hasta que se cancele. La cancelación se hace en los ajustes de tu cuenta de la App Store, al menos 24 horas antes de que termine el período."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura renova sozinha até ser cancelada. O cancelamento acontece nos ajustes da conta da App Store, ao menos 24 horas antes do fim do período."
          }
        }
      }
    },
    "There's no clinical evaluation, diagnosis, or follow-up care. Psychological suffering calls for a professional, and the two paths don't compete.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no clinical evaluation, diagnosis, or follow-up care. Psychological suffering calls for a professional, and the two paths don't compete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay evaluación clínica, diagnóstico ni seguimiento. El sufrimiento psíquico requiere un profesional, y los dos caminos no compiten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há avaliação clínica, diagnóstico nem acompanhamento. Sofrimento psíquico pede profissional, e os dois caminhos não competem."
          }
        }
      }
    },
