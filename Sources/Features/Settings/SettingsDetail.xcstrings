    "Deleting the app from this device removes everything it saved. Exporting a copy, and deleting your records without deleting the app, are not built yet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting the app from this device removes everything it saved. Exporting a copy, and deleting your records without deleting the app, are not built yet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar o app deste aparelho remove tudo o que ele guardou. Exportar uma cópia, e apagar seus registros sem apagar o app, ainda não estão prontos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar la app de este dispositivo elimina todo lo que guardó. Exportar una copia, y borrar tus registros sin borrar la app, todavía no están hechos."
          }
        }
      }
    },
    "Didn't find it? Write to {email} — we respond within two business days.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Didn't find it? Write to {email} — we respond within two business days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No lo encontraste? Escribe a {email} — respondemos en un plazo de dos días hábiles."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não achou? Escreva para {email} — respondemos em até dois dias úteis."
          }
        }
      }
    },
    "Each country has its own calendar over the general Roman one. This changes the saint of the day and the solemnities.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each country has its own calendar over the general Roman one. This changes the saint of the day and the solemnities."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada país tiene su propio calendario sobre el romano general. Esto cambia el santo del día y las solemnidades."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada país tem seu calendário próprio sobre o romano geral. Isso muda o santo do dia e as solenidades."
          }
        }
      }
    },
    "Everything in the app is available without one. If you subscribed with another Apple ID, restore below.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in the app is available without one. If you subscribed with another Apple ID, restore below."
