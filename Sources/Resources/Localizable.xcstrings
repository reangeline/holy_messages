    "The interface and all content are available in this language.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The interface and all content are available in this language."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A interface e todo o conteúdo estão disponíveis neste idioma."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La interfaz y todo el contenido están disponibles en este idioma."
          }
        }
      }
    },
    "The interface is fully translated. Content is available in {done} of {total} sections; the rest is shown in Portuguese until it is added.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The interface is fully translated. Content is available in {done} of {total} sections; the rest is shown in Portuguese until it is added."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A interface está totalmente traduzida. O conteúdo existe em {done} de {total} seções; o restante aparece em português até ser incluído."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La interfaz está totalmente traducida. El contenido existe en {done} de {total} secciones; el resto se muestra en portugués hasta que se incluya."
          }
        }
      }
    },
