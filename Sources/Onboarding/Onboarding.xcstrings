    "These answers stay on this device. They are never sent to a server, never used for ads, never used to sell you anything. Every question can be left unanswered.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These answers stay on this device. They are never sent to a server, never used for ads, never used to sell you anything. Every question can be left unanswered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas respuestas se quedan en este dispositivo. Nunca se envían a un servidor, nunca se usan para anuncios, nunca se usan para venderte nada. Toda pregunta puede quedar sin responder."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Essas respostas ficam neste aparelho. Nunca são enviadas a um servidor, nunca usadas para anúncios, nunca usadas para vender nada a você. Toda pergunta pode ficar sem resposta."
          }
        }
      }
    },
    "This app offers formation and prayer. It is not confession, spiritual direction, or therapy, and it never pretends to be.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app offers formation and prayer. It is not confession, spiritual direction, or therapy, and it never pretends to be."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app ofrece formación y oración. No es confesión, dirección espiritual ni terapia, y nunca finge serlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app oferece formação e oração. Não é confissão, direção espiritual nem terapia, e não finge ser."
